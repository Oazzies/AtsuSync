{
  "name": "@atsusync/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "start": "tsx --env-file-if-exists=../.env src/index.ts",
    "test": "vitest run --exclude test/live.test.ts",
    "test:live": "vitest run test/live.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@atsusync/shared": "*",
    "@fastify/static": "^8.1.0",
    "cheerio": "^1.0.0",
    "fastify": "^5.2.1",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "vitest": "^3.0.5"
  }
}
