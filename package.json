{
  "name": "atsusync",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "workspaces": ["shared", "server", "extension"],
  "scripts": {
    "dev": "concurrently -n server,ext -c blue,green \"npm run dev -w server\" \"npm run dev -w extension\"",
    "build": "npm run build -w extension",
    "start": "npm run start -w server",
    "test": "npm run test -w server",
    "test:live": "npm run test:live -w server",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w extension"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  }
}
